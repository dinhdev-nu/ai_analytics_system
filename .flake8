# Flake8 configuration for Python linting
# https://flake8.pycqa.org/en/latest/user/configuration.html

[flake8]
# Maximum line length
max-line-length = 88

# Complexity threshold
max-complexity = 10

# Error codes to ignore
ignore =
    # E203: whitespace before ':' (conflicts with Black)
    E203,
    # E501: line too long (handled by max-line-length)
    E501,
    # W503: line break before binary operator (conflicts with Black)
    W503,
    # W504: line break after binary operator
    W504

# Error codes to select
select =
    # Pycodestyle errors
    E,
    # Pycodestyle warnings
    W,
    # Pyflakes
    F,
    # Complexity
    C90,
    # Naming
    N

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .pytest_cache,
    .tox,
    build,
    dist,
    *.egg-info,
    .eggs,
    models,
    notebooks,
    tmp,
    temp

# Per-file ignores
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py:F401
    # Allow star imports in config files
    config.py:F403,F405
    # Allow print in scripts
    scripts/*:T001

# Show source code for each error
show-source = True

# Show statistics at the end
statistics = True

# Count errors
count = True

# Docstring conventions (numpy style)
docstring-convention = numpy

# Import order style
import-order-style = google

# Application import names (local packages)
application-import-names = training,prediction,database,config
