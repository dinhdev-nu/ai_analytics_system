# ============================================
# AI Analytics System - Environment Variables
# ============================================
# Copy this file to .env and update values

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_analytics
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Connection pool settings
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_TIMEOUT=30000

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Cache TTL (seconds)
REDIS_CACHE_TTL=3600
# Connection pool
REDIS_POOL_SIZE=10

# ============================================
# Backend API Configuration
# ============================================
API_PORT=8080
API_HOST=0.0.0.0
API_BASE_PATH=/api/v1
# Rate limiting
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
# CORS
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Request timeout (seconds)
API_REQUEST_TIMEOUT=30

# ============================================
# JWT Configuration (v1.1.0+)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# ============================================
# ETL Configuration
# ============================================
ETL_MODE=cron
# Cron schedule (daily at 2 AM)
ETL_SCHEDULE=0 2 * * *
ETL_BATCH_SIZE=1000
ETL_WORKERS=4
# Process data from N days ago
ETL_LOOKBACK_DAYS=730

# ============================================
# ML Configuration
# ============================================
# Model training
ML_MODEL_PATH=./ml/models
ML_MODEL_VERSION=v1.0.0
ML_PREDICTION_MONTHS=12
MLFLOW_TRACKING_URI=http://localhost:5000
# Prophet parameters
ML_PROPHET_CHANGEPOINT_SCALE=0.05
ML_PROPHET_SEASONALITY_MODE=multiplicative
ML_PROPHET_YEARLY_SEASONALITY=true
ML_PROPHET_WEEKLY_SEASONALITY=false
ML_PROPHET_DAILY_SEASONALITY=false
# Training schedule (weekly on Sunday at 3 AM)
ML_TRAINING_SCHEDULE=0 3 * * 0
# Prediction schedule (daily at 3 AM)
ML_PREDICTION_SCHEDULE=0 3 * * *

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=30

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_TITLE=AI Analytics
VITE_APP_VERSION=1.0.0

# ============================================
# Environment
# ============================================
ENV=development
# development | staging | production
NODE_ENV=development

# ============================================
# External Services (Optional)
# ============================================
# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Slack (for alerts)
SLACK_WEBHOOK_URL=

# Sentry (for error tracking)
SENTRY_DSN=

# AWS (for S3 backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ============================================
# Feature Flags (Future)
# ============================================
FEATURE_AUTHENTICATION=false
FEATURE_REALTIME=false
FEATURE_WEBHOOKS=false
FEATURE_EXPORT=true

# ============================================
# Performance & Monitoring
# ============================================
# Enable profiling
ENABLE_PROFILING=false
# Enable metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# Security
# ============================================
# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# API security
API_KEY_HEADER=X-API-Key
API_KEY=

# ============================================
# Development & Debug
# ============================================
DEBUG=false
VERBOSE=false
# Dry run mode (don't write to DB)
DRY_RUN=false

# ============================================
# ETL
ETL_CRON_SCHEDULE=0 2 * * *
ETL_BATCH_SIZE=1000

# Prediction
PREDICTION_CRON_SCHEDULE=0 3 * * *
PREDICTION_MONTHS_AHEAD=12

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Client
REACT_APP_API_URL=http://localhost:8080/api/v1
REACT_APP_ENABLE_MOCK=false
